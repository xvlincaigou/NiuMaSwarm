# Open Swarm - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# REQUIRED: Kimi API (for AI model access)
# Get your API key from: https://platform.moonshot.cn/
# =============================================================================
KIMI_API_KEY=your-kimi-api-key-here

# =============================================================================
# OPTIONAL: Search Tool (Serper - Google Search API)
# Get your API key from: https://serper.dev
# Without this, search functionality will not work
# =============================================================================
SERPER_API_KEY=your-serper-api-key-here

# =============================================================================
# OPTIONAL: Feishu/Lark Document Tool (for docx documents)
# Required if you want to create Feishu cloud documents
#
# How to get these credentials:
# 1. Go to https://open.feishu.cn/ (or https://open.larksuite.com/ for international)
# 2. Create a new app (创建应用)
# 3. Get App ID and App Secret from the app credentials page
# 4. Enable "docx:document:write" and "docx:document:read" permissions
# =============================================================================
FEISHU_APP_ID=your-feishu-app-id-here
FEISHU_APP_SECRET=your-feishu-app-secret-here
FEISHU_WIKI_SPACE_ID=your-feishu-space-id
# =============================================================================
# OPTIONAL: Feishu Wiki (知识库) Space ID
# Required for creating wiki documents (recommended for reports)
#
# How to find your space ID:
# 1. Open Feishu and go to your Wiki (知识库)
# 2. The URL will look like: https://www.feishu.cn/wiki/space/XXXXXX
# 3. Copy the XXXXXX part as your space ID
# If not set, the tool will try to use your default space
# =============================================================================
FEISHU_WIKI_SPACE_ID=your-wiki-space-id-here

# =============================================================================
# OPTIONAL: Alternative OpenAI-compatible API
# Use this if you want to use other models (e.g., Qwen, GPT, etc.)
# =============================================================================
# OPENAI_API_KEY=your-openai-compatible-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# =============================================================================
# Usage Instructions:
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and fill in your actual API keys
# 3. Load environment variables: source .env
# 4. Run the examples:
#    - python examples/simple_agent.py
#    - python examples/multi_agent.py
#    - python examples/research_report.py
#    - python run_examples/run_research_feishu.py
#
# Note: Never commit .env file with real API keys to git!
